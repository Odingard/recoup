# Recoup uses Gemini via Vertex AI so it runs on your $1,000 Google Cloud credit.
# (Gemini on Google AI Studio is NOT eligible for that credit.)
# Copy this file to .env inside recoup_agent/ and fill in your project.

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: enable offline sample identity for local demo flows.
RECOUP_SAMPLE_MODE=0

# Optional: Firebase Admin service account JSON or path to a JSON file.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Optional: Vertex AI Search RAG (see README). Leave unset to use local clause lookup. ---
VERTEX_AI_SEARCH_ENGINE_ID=
VERTEX_AI_SEARCH_LOCATION=global
