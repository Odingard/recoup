# Recoup Phase 1 — all runtime config is via environment variables.
# Copy this file to .env inside recoup_agent/ and fill in your values.
# Nothing here is baked into the image; provide these at deploy time (e.g. Cloud Run --set-env-vars).

# --- Gemini via Vertex AI (extraction / grounding / memo drafting) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Sample mode ---
# 1/true/yes/on -> API resolves an offline "sample" identity (synthetic book, no Firestore, no auth).
# Leave 0 in production so real Firebase auth is required.
RECOUP_SAMPLE_MODE=0

# --- Firebase Admin (backend ID-token verification) ---
# JSON contents OR a path to the service-account .json file.
# On Cloud Run you can omit this and rely on Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Customer billing connector (READ-ONLY) ---
# Restricted, read-only Stripe key for the CUSTOMER's Stripe account.
# STRIPE_API_KEY is preferred; STRIPE is accepted as a fallback.
STRIPE_API_KEY=
# Set to "stripe" to drive reconciliation usage/invoices from the Stripe connector
# instead of the synthetic/Firestore book.
RECOUP_BILLING_SOURCE=

# --- Recoup's OWN billing (success fee) ---
# SEPARATE Stripe account used to invoice Recoup's 20% success fee.
# Must NOT be the same key as the read-only customer connector above.
RECOUP_BILLING_STRIPE_API_KEY=

# --- Optional: Vertex AI Search RAG (see README). Leave unset to use local clause lookup. ---
VERTEX_AI_SEARCH_ENGINE_ID=
VERTEX_AI_SEARCH_LOCATION=global

# --- Server ---
PORT=8080
